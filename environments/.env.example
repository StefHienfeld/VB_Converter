# =============================================================================
# VB_CONVERTER ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env in the project root and adjust values as needed.
# All values shown are defaults - only override what you need to change.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true
APP_VERSION=3.1.0

# --- Security ---
# REQUIRED for production! Generate with: openssl rand -hex 32
SECRET_KEY=dev-only-change-in-production-openssl-rand-hex-32

# JWT Authentication (set to true in production!)
AUTH_ENABLED=false

# Metrics token: protects /metrics endpoint for off-host Prometheus scrapers.
# If not set, /metrics is only accessible from localhost (127.0.0.1 / ::1).
# Generate with: openssl rand -hex 32
# METRICS_TOKEN=

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000

# CORS: Comma-separated list of allowed origins
# Development: includes common local dev ports
# Production: should only include your actual frontend domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- NLP Settings (all local, no external API) ---
SPACY_MODEL=nl_core_news_md
SEMANTIC_ENABLED=true
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# --- Logging ---
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
# LOG_FORMAT: text (human readable) or json (structured)
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- Feature Flags ---
# FEATURE_AI_EXTENSIONS is deprecated - all analysis is local

# --- Database ---
# SQLite is the default: jobs survive server restarts with no extra setup.
# The file hienfeld_jobs.db is created automatically on first startup.
DATABASE_URL=sqlite:///./hienfeld_jobs.db
# Switch to PostgreSQL for multi-instance or production deployments:
# DATABASE_URL=postgresql://hienfeld:secret@localhost:5432/hienfeld_db

# --- LLM API (DISABLED) ---
# All NLP processing is local. No external API needed.
# LLM_API_KEY is NOT required.

# =============================================================================
# Frontend Environment Variables (Vite)
# =============================================================================
# These are used by the React frontend during build

VITE_ENVIRONMENT=development
VITE_API_URL=http://localhost:8000
VITE_APP_VERSION=3.1.0
VITE_FEATURE_AI=false
